#!/bin/bash
# gapi — Google API helper for Hermes
# Usage: scripts/gapi gmail search "is:unread" --max 10

export PYTHONIOENCODING=utf-8

if [ -n "$HERMES_HOME" ]; then
    export HERMES_HOME
elif [ -d "/c/Users/DELL/Desktop/jarvis-agent" ]; then
    export HERMES_HOME="/c/Users/DELL/Desktop/jarvis-agent"
else
    export HERMES_HOME="$HOME/.hermes"
fi

VENV_PYTHON="/c/Users/DELL/AppData/Local/hermes/hermes-agent/venv/Scripts/python.exe"
SCRIPT="$HERMES_HOME/skills/productivity/google-workspace/scripts/google_api.py"

if [ -f "$VENV_PYTHON" ]; then
    PYTHON="$VENV_PYTHON"
else
    PYTHON="python3"
fi

exec "$PYTHON" "$SCRIPT" "$@"
