[Unit]
Description=Sidekick proxy (Node.js PWA + /v1/* agent surface, HTTPS port 3001)
After=hermes-gateway.service network-online.target
Wants=hermes-gateway.service network-online.target

[Service]
Type=simple
WorkingDirectory={{SIDEKICK_PATH}}
EnvironmentFile={{SIDEKICK_PATH}}/.env
Environment=SIDEKICK_PUSH_OWNED_BY_PLUGIN=true
Environment=SIDEKICK_INFLIGHT_OWNED_BY_PLUGIN=true
ExecStartPre={{NODE_BIN_DIR}}/npm run build
ExecStart={{NODE_BIN_DIR}}/node --experimental-strip-types --disable-warning=ExperimentalWarning server.ts
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
