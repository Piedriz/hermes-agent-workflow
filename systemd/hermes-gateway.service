[Unit]
Description=Hermes Agent gateway (API server + messaging platform adapters)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# `run` is the foreground/systemd-friendly variant (vs `start` which expects
# an already-installed service). API server reads API_SERVER_* from
# ~/.hermes/.env; platform adapters (telegram, etc.) read their tokens same place.
ExecStart=%h/.local/bin/hermes gateway run
Restart=on-failure
RestartSec=10
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Auto-approve unseen shell hooks so the service doesn't hang waiting for a
# TTY prompt. Equivalent to --accept-hooks / hooks_auto_accept: true.
Environment=HERMES_ACCEPT_HOOKS=1
# OPTIONAL: plugin-owned push dispatch. When set, the sidekick plugin
# dispatches Web Push directly from its in-process bus instead of
# delegating up through the sidekick proxy. The sidekick proxy's own
# SIDEKICK_PUSH_OWNED_BY_PLUGIN flag MUST match this one — if only
# one side has it, push fires zero times (proxy delegates, plugin
# skips). Default: unset (legacy proxy-side dispatch). Set both to
# true if you're using the plugin-side dispatcher (sidekick.db push
# subs + sidekick_dispatcher.py).
# Environment=SIDEKICK_PUSH_OWNED_BY_PLUGIN=true

[Install]
WantedBy=default.target
