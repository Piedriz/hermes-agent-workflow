[Unit]
Description=Hermes Agent web dashboard (config, keys, sessions)
After=tailscaled.service network-online.target
Wants=network-online.target

[Service]
Type=simple
# Bind directly to the tailnet hostname. Socket lives on the tailnet
# interface only (not LAN-reachable). --insecure is required to bind
# non-loopback, but the dashboard's Host-header defense still kicks
# in: only requests with Host: ${HERMES_DASHBOARD_HOST} are accepted.
#
# HERMES_DASHBOARD_HOST is read from ~/.hermes/.env so the unit file
# doesn't need per-host editing. Set it to your tailnet FQDN there:
#   HERMES_DASHBOARD_HOST=<your-host>.tailXXXX.ts.net
EnvironmentFile=%h/.hermes/.env
ExecStart=/bin/sh -c '%h/.local/bin/hermes dashboard --host ${HERMES_DASHBOARD_HOST} --port 9119 --no-open --insecure'
Restart=on-failure
RestartSec=5
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Point hermes at the prebuilt web UI so it doesn't re-run `npm run build`
# (tsc + vite) on every service start — that's a minutes-long CPU burn on the Pi.
Environment=HERMES_WEB_DIST=%h/.hermes/hermes-agent/hermes_cli/web_dist

[Install]
WantedBy=default.target
