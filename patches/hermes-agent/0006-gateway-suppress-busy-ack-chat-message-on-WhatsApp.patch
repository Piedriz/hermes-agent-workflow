From 335876176fd479b69a25eb064fac15fceb7be532 Mon Sep 17 00:00:00 2001
From: hermes-agent-workflow contributor <noreply@hermes-agent-workflow>
Date: Sat, 25 Apr 2026 10:45:24 -0400
Subject: [PATCH 6/8] gateway: suppress busy-ack chat message on WhatsApp
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The "[bot] ⚡ Interrupting current task (iteration N/M)" leak is
landing in WhatsApp groups as user-visible replies. In casual group
contexts this reads as the bot narrating its own internals — humans
find it weird and it breaks conversation flow.

Local patch: when the platform is WhatsApp, suppress the busy-ack
chat send. The interrupt itself still fires (line 1572 above) — we
just don't narrate it inline. Other platforms (Telegram, Slack,
api_server / sidekick) keep the busy-ack since their UX expects it.

Tracked upstream as part of issue #5151 (gateway-status-leak family).

Co-Authored-By: Claude Opus 4.7 (1M context) <noreply@anthropic.com>
---
 gateway/run.py | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/gateway/run.py b/gateway/run.py
index 8fda2c1f..77b1ae07 100644
--- a/gateway/run.py
+++ b/gateway/run.py
@@ -1652,6 +1652,19 @@ class GatewayRunner:
             logger.debug("Failed to apply busy-input onboarding hint: %s", _onb_err)
 
         thread_meta = {"thread_id": event.source.thread_id} if event.source.thread_id else None
+
+        # Local patch: suppress the busy-ack chat message on WhatsApp.
+        # In group contexts the bot's
+        # "[bot] ⚡ Interrupting current task (iteration 1/60)..." inline
+        # leak is louder than the value it adds — humans in a casual
+        # WhatsApp conversation don't want internal agent status notices
+        # appearing as inline replies. The interrupt itself still fires
+        # above (line 1572); we just don't narrate it. Reported in
+        # upstream issue #5151 as part of the gateway-status-leak family.
+        from gateway.config import Platform as _Platform
+        if event.source.platform == _Platform.WHATSAPP:
+            return True
+
         try:
             await adapter._send_with_retry(
                 chat_id=event.source.chat_id,
-- 
