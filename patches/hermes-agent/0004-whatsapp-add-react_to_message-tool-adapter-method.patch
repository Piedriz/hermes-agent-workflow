index ad41f1ed..c3669ebd 100644
--- a/gateway/platforms/whatsapp.py
+++ b/gateway/platforms/whatsapp.py
@@ -755,6 +755,52 @@ class WhatsAppAdapter(BasePlatformAdapter):
         except Exception as e:
             return SendResult(success=False, error=str(e))
 
+    async def react_to_message(
+        self,
+        chat_id: str,
+        message_id: str,
+        from_me: bool,
+        participant: Optional[str],
+        emoji: str,
+    ) -> bool:
+        """React to a previously-received message with an emoji.
+
+        Pass an empty string for ``emoji`` to clear an existing reaction.
+        ``participant`` is required for group messages (the sender of the
+        target message); pass None for 1:1 chats.
+        """
+        if not self._running or not self._http_session:
+            return False
+        if await self._check_managed_bridge_exit():
+            return False
+        try:
+            import aiohttp
+            payload: Dict[str, Any] = {
+                "chatId": chat_id,
+                "messageId": message_id,
+                "fromMe": bool(from_me),
+                "emoji": emoji,
+            }
+            if participant:
+                payload["participant"] = participant
+            async with self._http_session.post(
+                f"http://127.0.0.1:{self._bridge_port}/react",
+                json=payload,
+                timeout=aiohttp.ClientTimeout(total=15),
+            ) as resp:
+                if resp.status == 200:
+                    return True
+                logger.warning(
+                    "[%s] react_to_message bridge error %s: %s",
+                    self.name, resp.status, await resp.text(),
+                )
+                return False
+        except Exception as e:
+            logger.warning("[%s] react_to_message failed: %s", self.name, e)
+            return False
+        except Exception as e:
+            return SendResult(success=False, error=str(e))
