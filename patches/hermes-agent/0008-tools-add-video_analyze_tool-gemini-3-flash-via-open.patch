+# ---------------------------------------------------------------------------
+# Video analysis
+# ---------------------------------------------------------------------------
+#
+# Companion to vision_analyze_tool that accepts video files. Gemini 3 Flash
+# Preview (the configured auxiliary vision model) supports native video input
+# over the OpenAI-compatible chat completions API by overloading the
+# `image_url` content block with a `data:video/mp4;base64,...` URL.
+#
+# Strategy:
+#   1. If video <= ~20MB, try sending inline base64 to the same vision
+#      provider as a single `image_url` content block.
+#   2. On size-rejection or inline-video-rejection failures, fall back to
+#      ffmpeg/PyAV keyframe extraction (4-8 evenly-spaced frames) and run
+#      vision_analyze_tool on each, then concatenate.
+#   3. If video > 20MB on disk, skip the inline attempt and go straight to
+#      keyframe extraction.
+
+# Hard cap for inline video uploads. Gemini documents 20MB as the inline
+# request size limit. Above this, keyframe-extract and analyze frames.
+_MAX_INLINE_VIDEO_BYTES = 20 * 1024 * 1024
+
+# Number of keyframes to extract when falling back. Gemini-2.5/3 vision
+# context comfortably fits 6 images at ~1MP each.
+_KEYFRAME_COUNT_DEFAULT = 6
+
+
+def _detect_video_mime_type(video_path: Path) -> Optional[str]:
+    """Return a MIME type when the file looks like a supported video."""
+    suffix = video_path.suffix.lower()
+    suffix_map = {
+        ".mp4": "video/mp4",
+        ".m4v": "video/mp4",
+        ".mov": "video/quicktime",
+        ".webm": "video/webm",
+        ".mkv": "video/x-matroska",
+        ".avi": "video/x-msvideo",
+        ".3gp": "video/3gpp",
+    }
+    if suffix in suffix_map:
+        return suffix_map[suffix]
+
+    # Fall back to magic-bytes sniffing for ftyp boxes (mp4/mov/3gp share
+    # the ISO base media file format header).
+    try:
+        with video_path.open("rb") as f:
+            header = f.read(32)
+    except OSError:
+        return None
+    if len(header) >= 12 and header[4:8] == b"ftyp":
+        return "video/mp4"
+    if header.startswith(b"\x1aE\xdf\xa3"):  # EBML / Matroska / WebM
+        return "video/webm"
+    return None
+
+
+def _video_to_base64_data_url(video_path: Path, mime_type: str) -> str:
+    """Convert a video file to a base64-encoded data URL."""
+    data = video_path.read_bytes()
+    encoded = base64.b64encode(data).decode("ascii")
+    return f"data:{mime_type};base64,{encoded}"
+
+
+def _is_video_format_error(error: Exception) -> bool:
+    """Detect if an API error is related to video format rejection."""
+    err_str = str(error).lower()
+    return any(hint in err_str for hint in (
+        "video", "media type", "unsupported", "invalid_request",
+        "could not process", "mime",
+    ))
+
+
+def _probe_video_duration(video_path: Path) -> float:
+    """Return the duration of a video in seconds, or 0.0 if unknown.
+
+    Uses ffprobe (shipped with ffmpeg). Returns 0.0 on any error.
+    """
+    import subprocess
+    try:
+        out = subprocess.run(
+            [
+                "ffprobe", "-v", "error", "-show_entries", "format=duration",
+                "-of", "default=noprint_wrappers=1:nokey=1", str(video_path),
+            ],
+            capture_output=True, text=True, timeout=15,
+        )
+        if out.returncode == 0 and out.stdout.strip():
+            return float(out.stdout.strip())
+    except Exception:
+        pass
+    return 0.0
+
+
+def _extract_video_keyframes(video_path: Path, count: int = _KEYFRAME_COUNT_DEFAULT) -> list:
+    """Extract `count` evenly-spaced keyframes from a video.
+
+    Uses the ffmpeg binary (avoids PIL dependency which PyAV's to_image()
+    requires). Returns a list of Path objects pointing to JPEG files under
+    ./temp_vision_images/. Caller is responsible for cleanup.
+    """
+    import subprocess
+
+    out_dir = Path("./temp_vision_images")
+    out_dir.mkdir(parents=True, exist_ok=True)
+
+    duration = _probe_video_duration(video_path)
+    frames_written: list = []
+    session_id = uuid.uuid4().hex
+
+    if duration and duration > 0:
+        # Sample at fractions [1/(n+1), 2/(n+1), ..., n/(n+1)] of duration to
+        # skip the first/last frames (often black or transition cuts).
+        timestamps = [duration * (i + 1) / (count + 1) for i in range(count)]
+        for idx, ts in enumerate(timestamps):
+            out_path = out_dir / f"vid_kf_{session_id}_{idx:02d}.jpg"
+            try:
+                # -ss before -i is fast (input seek), -frames:v 1 grabs one
+                # frame, -q:v 3 = high JPEG quality (~85), scaled to <=1280
+                # on the long side to keep the per-frame payload small.
+                proc = subprocess.run(
+                    [
+                        "ffmpeg", "-y", "-loglevel", "error",
+                        "-ss", f"{ts:.3f}",
+                        "-i", str(video_path),
+                        "-frames:v", "1",
+                        "-vf", "scale='min(1280,iw)':-2",
+                        "-q:v", "3",
+                        str(out_path),
+                    ],
+                    capture_output=True, text=True, timeout=30,
+                )
+                if proc.returncode == 0 and out_path.exists() and out_path.stat().st_size > 0:
+                    frames_written.append(out_path)
+                else:
+                    logger.warning(
+                        "ffmpeg failed to extract frame at %.2fs (rc=%d): %s",
+                        ts, proc.returncode, proc.stderr[:200],
+                    )
+            except Exception as exc:
+                logger.warning("Frame extraction error at %.2fs: %s", ts, exc)
+    else:
+        # Unknown duration — extract `count` evenly-spaced frames using
+        # ffmpeg's select filter via fps. Heuristic: 1 frame per second
+        # capped at `count`.
+        out_pattern = out_dir / f"vid_kf_{session_id}_%02d.jpg"
+        try:
+            proc = subprocess.run(
+                [
+                    "ffmpeg", "-y", "-loglevel", "error",
+                    "-i", str(video_path),
+                    "-vf", f"select='eq(pict_type,I)',scale='min(1280,iw)':-2",
+                    "-vsync", "vfr", "-frames:v", str(count),
+                    "-q:v", "3",
+                    str(out_pattern),
+                ],
+                capture_output=True, text=True, timeout=60,
+            )
+            if proc.returncode == 0:
+                for p in sorted(out_dir.glob(f"vid_kf_{session_id}_*.jpg")):
+                    if p.stat().st_size > 0:
+                        frames_written.append(p)
+        except Exception as exc:
+            logger.warning("Bulk keyframe extraction failed: %s", exc)
+
+    if not frames_written:
+        raise RuntimeError("Keyframe extraction produced no frames")
+    return frames_written
+
+
+async def _analyze_video_via_keyframes(
+    video_path: Path,
+    user_prompt: str,
+    model: Optional[str],
+) -> str:
+    """Fallback path: extract keyframes and analyze each with the image
+    vision tool, then concatenate descriptions into one analysis string.
+    """
+    frames = await asyncio.to_thread(_extract_video_keyframes, video_path)
+    try:
+        per_frame_prompt = (
+            "This is one frame sampled from a short video. "
+            "Describe what is happening in this frame in detail "
+            "(people, actions, text, objects, setting). Keep it under 4 "
+            "sentences. The user's overall question about the video is: "
+            f"{user_prompt}"
+        )
+        descriptions = []
+        for idx, frame_path in enumerate(frames):
+            try:
+                result_json = await vision_analyze_tool(
+                    image_url=str(frame_path),
+                    user_prompt=per_frame_prompt,
+                    model=model,
+                )
+                payload = json.loads(result_json)
+                if payload.get("success"):
+                    descriptions.append(
+                        f"Frame {idx + 1}/{len(frames)}: {payload.get('analysis', '').strip()}"
+                    )
+                else:
+                    descriptions.append(
+                        f"Frame {idx + 1}/{len(frames)}: [analysis failed]"
+                    )
+            except Exception as exc:
+                logger.warning("Per-frame analysis failed (frame %d): %s", idx, exc)
+                descriptions.append(
+                    f"Frame {idx + 1}/{len(frames)}: [analysis error: {exc}]"
+                )
+
+        # Stitch a coherent summary preface so callers see one description,
+        # not a frame dump.
+        preface = (
+            f"Video analyzed via keyframe sampling ({len(frames)} frames). "
+            "Sequential observations follow:\n\n"
+        )
+        return preface + "\n\n".join(descriptions)
+    finally:
+        # Clean up extracted frames
+        for frame_path in frames:
+            try:
+                frame_path.unlink()
+            except Exception:
+                pass
+
+
+# Need asyncio at module scope for keyframe path
+import asyncio  # noqa: E402  (intentional late import to avoid reordering existing module top)
+
+
+async def video_analyze_tool(
+    video_url: str,
+    user_prompt: str,
+    model: str = None,
+) -> str:
+    """
+    Analyze a video from a URL or local file path using vision AI.
+
+    Mirrors vision_analyze_tool but accepts video. Tries to send the video
+    inline (base64) to a Gemini-class model first; on size/format failure
+    or videos > 20MB, falls back to ffmpeg/PyAV keyframe extraction and
+    per-frame image analysis.
+
+    Args:
+        video_url (str): http(s) URL or local file path to a video file
+                         (mp4/mov/webm/mkv/etc).
+        user_prompt (str): What the user wants to know about the video.
+        model (str): Optional override of the auxiliary vision model.
+
+    Returns:
+        str: JSON string {"success": bool, "analysis": str, [...]}.
+    """
+    debug_call_data = {
+        "parameters": {
+            "video_url": video_url,
+            "user_prompt": (user_prompt[:200] + "...") if len(user_prompt) > 200 else user_prompt,
+            "model": model,
+        },
+        "error": None,
+        "success": False,
+        "analysis_length": 0,
+        "model_used": model,
+        "video_size_bytes": 0,
+        "fallback_used": None,
+    }
+
+    temp_video_path: Optional[Path] = None
+    should_cleanup = False
+
+    try:
+        from tools.interrupt import is_interrupted
+        if is_interrupted():
+            return tool_error("Interrupted", success=False)
+
+        logger.info("Analyzing video: %s", video_url[:60])
+        logger.info("User prompt: %s", user_prompt[:100])
+
+        # Resolve local path vs URL — same shape as vision tool.
+        resolved_url = video_url
+        if resolved_url.startswith("file://"):
+            resolved_url = resolved_url[len("file://"):]
+        local_path = Path(os.path.expanduser(resolved_url))
+        if local_path.is_file():
+            logger.info("Using local video file: %s", video_url)
+            temp_video_path = local_path
+            should_cleanup = False
+        elif _validate_image_url(video_url):
+            blocked = check_website_access(video_url)
+            if blocked:
+                raise PermissionError(blocked["message"])
+            logger.info("Downloading video from URL...")
+            temp_dir = Path("./temp_vision_images")
+            temp_video_path = temp_dir / f"temp_video_{uuid.uuid4().hex}.mp4"
+            await _download_image(video_url, temp_video_path)
+            should_cleanup = True
+        else:
+            raise ValueError(
+                "Invalid video source. Provide an HTTP/HTTPS URL or a valid "
+                "local file path."
+            )
+
+        video_size_bytes = temp_video_path.stat().st_size
+        debug_call_data["video_size_bytes"] = video_size_bytes
+        logger.info("Video ready (%.1f MB)", video_size_bytes / (1024 * 1024))
+
+        mime_type = _detect_video_mime_type(temp_video_path) or "video/mp4"
+
+        # If oversized, skip inline and go straight to keyframe extraction.
+        analysis: Optional[str] = None
+        if video_size_bytes > _MAX_INLINE_VIDEO_BYTES:
+            logger.info(
+                "Video is %.1f MB (> %.0f MB inline limit); using keyframe fallback",
+                video_size_bytes / (1024 * 1024),
+                _MAX_INLINE_VIDEO_BYTES / (1024 * 1024),
+            )
+            debug_call_data["fallback_used"] = "keyframes_oversized"
+            analysis = await _analyze_video_via_keyframes(
+                temp_video_path, user_prompt, model
+            )
+        else:
+            # Try inline base64 video to Gemini via OpenRouter first.
+            try:
+                logger.info("Encoding video as base64 (mime=%s)...", mime_type)
+                video_data_url = _video_to_base64_data_url(temp_video_path, mime_type)
+                logger.info(
+                    "Video encoded (%.1f MB base64), submitting to vision provider...",
+                    len(video_data_url) / (1024 * 1024),
+                )
+
+                messages = [
+                    {
+                        "role": "user",
+                        "content": [
+                            {"type": "text", "text": user_prompt},
+                            {"type": "image_url", "image_url": {"url": video_data_url}},
+                        ],
+                    }
+                ]
+
+                vision_timeout = 180.0
+                vision_temperature = 0.1
+                try:
+                    from hermes_cli.config import load_config
+                    _cfg = load_config()
+                    _vision_cfg = _cfg.get("auxiliary", {}).get("vision", {})
+                    _vt = _vision_cfg.get("timeout")
+                    if _vt is not None:
+                        vision_timeout = max(float(_vt), 60.0)
+                    _vtemp = _vision_cfg.get("temperature")
+                    if _vtemp is not None:
+                        vision_temperature = float(_vtemp)
+                except Exception:
+                    pass
+
+                call_kwargs = {
+                    "task": "vision",
+                    "messages": messages,
+                    "temperature": vision_temperature,
+                    "max_tokens": 2000,
+                    "timeout": vision_timeout,
+                }
+                if model:
+                    call_kwargs["model"] = model
+
+                response = await async_call_llm(**call_kwargs)
+                analysis = extract_content_or_reasoning(response)
+                if not analysis:
+                    logger.warning(
+                        "Vision LLM returned empty content for video, retrying once"
+                    )
+                    response = await async_call_llm(**call_kwargs)
+                    analysis = extract_content_or_reasoning(response)
+            except Exception as inline_err:
+                logger.warning(
+                    "Inline video analysis failed (%s); falling back to keyframes",
+                    inline_err,
+                )
+                debug_call_data["fallback_used"] = "keyframes_after_inline_failure"
+                debug_call_data["inline_error"] = str(inline_err)[:200]
+                analysis = await _analyze_video_via_keyframes(
+                    temp_video_path, user_prompt, model
+                )
+
+        analysis_length = len(analysis or "")
+        logger.info("Video analysis completed (%s characters)", analysis_length)
+
+        result = {
+            "success": True,
+            "analysis": analysis or (
+                "There was a problem with the request and the video could not "
+                "be analyzed."
+            ),
+        }
+        if debug_call_data.get("fallback_used"):
+            result["fallback"] = debug_call_data["fallback_used"]
+
+        debug_call_data["success"] = True
+        debug_call_data["analysis_length"] = analysis_length
+        _debug.log_call("video_analyze_tool", debug_call_data)
+        _debug.save()
+
+        return json.dumps(result, indent=2, ensure_ascii=False)
+
+    except Exception as e:
+        error_msg = f"Error analyzing video: {str(e)}"
+        logger.error("%s", error_msg, exc_info=True)
+        result = {
+            "success": False,
+            "error": error_msg,
+            "analysis": (
+                "There was a problem with the request and the video could not "
+                f"be analyzed. Error: {e}"
+            ),
+        }
+        debug_call_data["error"] = error_msg
+        _debug.log_call("video_analyze_tool", debug_call_data)
+        _debug.save()
+        return json.dumps(result, indent=2, ensure_ascii=False)
+
+    finally:
+        if should_cleanup and temp_video_path and temp_video_path.exists():
+            try:
+                temp_video_path.unlink()
+                logger.debug("Cleaned up temporary video file")
+            except Exception as cleanup_error:
+                logger.warning(
+                    "Could not delete temporary video file: %s",
+                    cleanup_error,
+                    exc_info=True,
+                )
+
+
+VIDEO_ANALYZE_SCHEMA = {
+    "name": "video_analyze",
+    "description": (
+        "Analyze a video using AI vision. Accepts an HTTP(S) URL or a local "
+        "file path (e.g. an inbound WhatsApp/Telegram video cached by the "
+        "gateway). Returns a description of the video's contents and answers "
+        "the user's question. Uses Gemini's native video input when the file "
+        "is small enough; otherwise samples keyframes."
+    ),
+    "parameters": {
+        "type": "object",
+        "properties": {
+            "video_url": {
+                "type": "string",
+                "description": (
+                    "Video URL (http/https) or absolute local file path "
+                    "(e.g. /tmp/.../video_<id>.mp4) to analyze."
+                ),
+            },
+            "question": {
+                "type": "string",
+                "description": (
+                    "Your specific question or request about the video. The "
+                    "AI will provide a description AND answer your question."
+                ),
+            },
+        },
+        "required": ["video_url", "question"],
+    },
+}
+
+
+def _handle_video_analyze(args: Dict[str, Any], **kw: Any) -> Awaitable[str]:
+    video_url = args.get("video_url", "")
+    question = args.get("question", "")
+    full_prompt = (
+        "Fully describe what happens in this video, then answer the "
+        f"following question:\n\n{question}"
+    )
+    model = os.getenv("AUXILIARY_VISION_MODEL", "").strip() or None
+    return video_analyze_tool(video_url, full_prompt, model)
+
+
+registry.register(
+    name="video_analyze",
+    toolset="vision",
+    schema=VIDEO_ANALYZE_SCHEMA,
+    handler=_handle_video_analyze,
+    check_fn=check_vision_requirements,
+    is_async=True,
+    emoji="🎞️",
+)
