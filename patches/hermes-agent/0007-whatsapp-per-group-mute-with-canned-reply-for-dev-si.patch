From b1d7c1ce5ceefcb27abb84b03106b38ab2e56e91 Mon Sep 17 00:00:00 2001
From: Jonathan Scholz <jonathan.scholz@gmail.com>
Date: Sun, 26 Apr 2026 04:27:55 -0400
Subject: [PATCH 7/8] whatsapp: per-group mute with canned reply for dev
 silencing

Adds `whatsapp.group_muted` (list of group JIDs) and
`whatsapp.muted_reply` (canned string) config keys. When a message
arrives in a muted group AFTER the existing allowlist + mention gate
has already approved it, the bridge posts the canned reply via the
normal `/send` endpoint and `_build_message_event` returns None so
the agent never gets dispatched. Lets Jonathan silence specific
groups during dev work without disabling the whole platform.

Default `group_muted: []` makes the feature inert until populated.
No interaction with the f1edf21b busy-ack suppression: by returning
None we exit before any MessageEvent reaches `handle_message`, so
`run.py`'s dispatch path never runs in the muted case.

Co-Authored-By: Claude Opus 4.7 (1M context) <noreply@anthropic.com>
---
 gateway/platforms/whatsapp.py | 23 +++++++++++++++++++++++
 1 file changed, 23 insertions(+)

diff --git a/gateway/platforms/whatsapp.py b/gateway/platforms/whatsapp.py
index 59138c14..50816b11 100644
--- a/gateway/platforms/whatsapp.py
+++ b/gateway/platforms/whatsapp.py
@@ -179,6 +179,16 @@ class WhatsAppAdapter(BasePlatformAdapter):
         self._allow_from = self._coerce_allow_list(config.extra.get("allow_from") or config.extra.get("allowFrom"))
         self._group_policy = str(config.extra.get("group_policy") or os.getenv("WHATSAPP_GROUP_POLICY", "open")).strip().lower()
         self._group_allow_from = self._coerce_allow_list(config.extra.get("group_allow_from") or config.extra.get("groupAllowFrom"))
+        # Per-group dev mute: if a group JID is in `group_muted`, the bot
+        # does not dispatch the message to the agent; instead the bridge
+        # posts `muted_reply` as a normal outbound message. Lets Jonathan
+        # silence specific groups during dev work without disabling the
+        # whole platform. Empty list (default) = feature inert.
+        self._group_muted = set(self._coerce_allow_list(config.extra.get("group_muted")))
+        self._muted_reply = str(
+            config.extra.get("muted_reply")
+            or "🤖 Bot is offline for dev work — back online soon!"
+        )
         self._mention_patterns = self._compile_mention_patterns()
         self._message_queue: asyncio.Queue = asyncio.Queue()
         self._bridge_log_fh = None
@@ -996,6 +1006,19 @@ class WhatsAppAdapter(BasePlatformAdapter):
             if not self._should_process_message(data):
                 return None
 
+            # Per-group dev mute. If this group is in `group_muted`, post
+            # the canned `muted_reply` and return None so the agent never
+            # gets dispatched. Runs *after* the allowlist + mention gate
+            # so we only canned-reply to messages we'd otherwise act on.
+            if data.get("isGroup", False) and self._group_muted:
+                chat_id = str(data.get("chatId") or "")
+                if chat_id in self._group_muted:
+                    try:
+                        await self.send(chat_id, self._muted_reply)
+                    except Exception as e:
+                        print(f"[{self.name}] Failed to send muted_reply: {e}", flush=True)
+                    return None
+
             # Determine message type
             msg_type = MessageType.TEXT
             if data.get("hasMedia"):
